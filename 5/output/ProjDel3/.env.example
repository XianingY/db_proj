# 复制为 .env 后按需修改；不创建 .env 也能使用下列默认值。
# 本文件由 docker compose 读取，原生路径使用 shell 环境变量。

# 课堂演示网页端口；宿主与容器内保持一致，确保 Origin 校验通过。
WEB_PORT=8000

# PostgreSQL 容器凭证与数据库名（仅 Docker 路径使用）。
POSTGRES_DB=research_lab
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=local-demo-only-change-me

# 业务 schema 名称；已存在时只复用，不覆盖、不清空。
LAB_SCHEMA=research_lab_del3
